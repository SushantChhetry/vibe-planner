# Clerk (https://dashboard.clerk.com → API keys; optional in keyless dev)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase (database + RLS with Clerk third-party auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use anon (legacy) OR publishable (sb_publishable_…) from Project Settings → API Keys — never service_role/secret.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your-publishable-key
# Backend only (webhooks, ensureClerkProfile). Never expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PRICE_PRO=price_your-stripe-price-id
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
